{
  "name": "scanrail-repo",
  "private": true,
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raeseoklee/scanrail.git"
  },
  "bugs": {
    "url": "https://github.com/raeseoklee/scanrail/issues"
  },
  "homepage": "https://github.com/raeseoklee/scanrail#readme",
  "workspaces": [
    "packages/npm/scanrail",
    "packages/npm/cli",
    "packages/npm/cli-darwin-arm64",
    "packages/npm/cli-darwin-x64",
    "packages/npm/cli-win32-x64",
    "packages/npm/cli-win32-arm64",
    "packages/npm/cli-linux-x64",
    "packages/npm/cli-linux-arm64"
  ],
  "scripts": {
    "test": "go test ./... && node packages/npm/cli/test-wrapper.mjs && node packages/npm/scanrail/test-wrapper.mjs",
    "build:release": "node scripts/build-release.mjs",
    "pack:dry-run": "npm pack --workspaces --dry-run",
    "publish:dry-run": "npm run build:release && node scripts/publish-npm.mjs --dry-run",
    "publish:npm": "npm run build:release && node scripts/publish-npm.mjs --publish",
    "smoke:npm": "node scripts/npm-smoke.mjs",
    "docs:check-links": "node scripts/check-markdown-links.mjs",
    "experiment:scanner-spike": "node experiments/scanner-adapter-spike/run.mjs",
    "experiment:scanner-spike:summary": "node experiments/scanner-adapter-spike/run.mjs --summary"
  }
}
